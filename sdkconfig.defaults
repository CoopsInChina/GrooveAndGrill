# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM (OPI 8MB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0  # 0 = all malloc() → PSRAM (internal stays free for DMA)
# Allow EXT_RAM_BSS_ATTR to place static arrays in PSRAM, freeing DRAM for task stacks
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Cache — wider cache lines improve RGB DMA throughput
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# LVGL colour depth (must match RGB panel bits_per_pixel)
CONFIG_LV_COLOR_DEPTH_16=y

# LVGL's internal object/style memory pool. This is a static buffer in
# INTERNAL DRAM (separate from the general heap, so heap_caps_get_free_size()
# can't see it), which means it competes with FreeRTOS task stacks for DRAM.
# The default 32KB was too small — every screen ever visited eats into it
# permanently (screens are cached forever; see ui_screen_invalidate() in
# ui_common.c) and it exhausted (lv_obj_create() returns NULL, crash). But
# 128KB starved DRAM so the Sonos poll/cmd tasks failed to spawn. Measured
# worst-case usage across all 12 screens is ~50KB. Trimmed to 64KB to give the
# BLE controller its DRAM back (see BT section below) while keeping ~14KB of
# pool headroom. Longer term the fix is to free unused screens or move this
# pool to PSRAM.
CONFIG_LV_MEM_SIZE_KILOBYTES=64

# Enable Montserrat fonts used by the Music & Meat UI
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_12=y

# Complex drawing required for transform zoom (3× speed digit scaling)
CONFIG_LV_DRAW_COMPLEX=y
# PNG decoder for embedded icon images
CONFIG_LV_USE_PNG=y
# SJPG/TJpgDec: enables standard JPEG decode — required for album art
CONFIG_LV_USE_SJPG=y
# QR code widget for WiFi setup screen
CONFIG_LV_USE_QRCODE=y

# FreeRTOS tick rate — 1 kHz gives 1 ms resolution for LVGL timers
CONFIG_FREERTOS_HZ=1000
# Timer service task stack — default 2048 is too small when autodim calls lv_anim_start
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Disable legacy I2C driver warning (we use the legacy driver for simplicity)
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
# Phones send long headers (User-Agent etc) — default 512 causes 431 errors
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Console via UART0 (GPIO43=TX, GPIO44=RX) — reliable across ROM + app.
# Switch to USB_SERIAL_JTAG later when CAN bus needs GPIO43/44.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Main task stack — default 3584 is too small once UI + QR gen + Sonos init stack up
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# MBedTLS: use the default ESP-IDF heap allocator (PSRAM-aware) instead of the internal
# allocator so TLS I/O buffers land in PSRAM. Fixes MBEDTLS_ERR_SSL_ALLOC_FAILED (-0x7F00).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# TLS 1.3 disabled: ESP-IDF 5.3.1 experimental client sends wrong Finished MAC →
# -0x7780 FATAL_ALERT_MESSAGE on any server that accepts the offer.
# All art CDNs (TuneIn, Spotify) work with TLS 1.2.

# ---- Bluetooth LE (BBQ Box receiver) ----
# NimBLE host. We only ever passive-scan the BBQ Box's connectionless
# advertisements, so OBSERVER is the role we use. CENTRAL is left ENABLED even
# though we never connect: NimBLE in this IDF (5.3.1) fails to compile in a pure
# observer-only build — ble_gap_host_check_status() calls ble_gap_adv_active_
# instance(), which is only declared when an advertising/central role is on
# (-Werror=implicit-function-declaration). CENTRAL costs a little host RAM but
# builds cleanly. No peripheral/broadcaster (we never advertise).
# Runs alongside WiFi — coexistence is handled by the IDF controller.
# NOTE: the BLE controller + host need internal DRAM; this build is already
# DRAM-tight (see LV_MEM_SIZE_KILOBYTES history). Classic BT memory is
# released at init. Watch free DRAM on first boot.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Direct wireless-probe mode holds up to 2 concurrent probe connections.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# NimBLE host stack's dynamic allocations (connection/GATT state, scales with
# MAX_CONNECTIONS) → PSRAM instead of internal DRAM. Going from 1 to 2
# connections cost enough internal DRAM to starve the Sonos cmd_task again;
# this is the structural fix rather than shaving more buffers. Only the
# controller's own link-layer/DMA buffers (CONFIG_BT_CTRL_* below) must stay
# internal — those are unaffected by this setting.
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Controller/host memory trims — this build is DRAM-tight and the BLE
# controller needs a contiguous internal-DRAM block at init. These keep it
# small enough to allocate alongside LVGL + WiFi + the Sonos tasks. (Also:
# bbq_ble_init() runs BEFORE the Sonos/art/weather tasks in main.c so the
# controller gets first claim on unfragmented DRAM — without that ordering,
# init fails with "BLE_INIT: Malloc failed".)
#
# Box mode uses one scan; direct-probe mode uses one scan + up to two probe
# connections, so MAX_ACT=3 covers the worst case. The controller's adv-report
# + scan-dedup buffers can stay small (we pass filter_duplicates=0).
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=16
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=16
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4
