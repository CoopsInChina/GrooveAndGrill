# macOS metadata
.DS_Store

# Device-specific saved sdkconfig variants
sdkconfig.music_meat

# WiFi credentials — never commit this file
src/wifi_config.h

# Proprietary logo asset and its generated C conversion — but README
# screenshots/hardware photos are documentation, not proprietary art, so
# that one subfolder is explicitly tracked. (Must be assets/* + negate the
# subfolder, not assets/ + negate inside it — git won't descend into an
# ignored directory to evaluate negations for its contents.)
assets/*
!assets/ReadmePictures
src/logo_img.c
src/logo_img.h

# PlatformIO build artefacts
.pio/
.pioenvs/
.piolibdeps/
sdkconfig
managed_components/

# dependencies.lock IS tracked (repo root): pins managed
# component versions (esp_lvgl_port, lvgl) to what's actually been tested,
# so a from-scratch CI build can't silently pull a newer component release
# with different behaviour than the locally verified build.

# Python bytecode cache
__pycache__/
*.pyc
